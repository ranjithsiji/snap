/vendor/
/node_modules/
/var/
/.env

# Wikimedia replica credentials. On Toolforge these live outside the repo,
# but they are easily copied in during local work — and they are live
# database credentials, so never let them be committed.
replica.my.cnf

# Vite builds the SPA straight into public/; only the PHP front controller
# and static extras are tracked.
/public/assets/
/public/index.html

/frontend/node_modules/
/frontend/dist/

# The frontend uses pnpm. A stray package-lock.json makes pnpm move the
# packages npm installed into node_modules/.ignored and reinstall them,
# so keep the npm lockfile from coming back.
/frontend/package-lock.json

.phpunit.result.cache
.DS_Store
*.log

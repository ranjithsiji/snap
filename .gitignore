/vendor/
/node_modules/
/var/
/.env

# Wikimedia replica credentials. On Toolforge these live outside the repo,
# but they are easily copied in during local work — and they are live
# database credentials, so never let them be committed.
replica.my.cnf

# Vite's output in public/ IS committed, unusually for build artefacts.
# Toolforge has no Node available to the tool, so the SPA is built on a
# developer machine and shipped in the repository — that is what makes
# this deployable by `git pull` alone. Rebuild and commit public/ with any
# frontend change, or the served bundle silently stays at the old one.

/frontend/node_modules/
/frontend/dist/

# The frontend uses pnpm. A stray package-lock.json makes pnpm move the
# packages npm installed into node_modules/.ignored and reinstall them,
# so keep the npm lockfile from coming back.
/frontend/package-lock.json

.phpunit.result.cache
.DS_Store
*.log

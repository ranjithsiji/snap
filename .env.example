# Copy to .env and adjust. Every value has a working default, so the app
# will boot without this file — but you must set JWT_SECRET in production.

APP_NAME="Snap"
APP_ENV=dev
APP_DEBUG=true
APP_URL=http://localhost:8080

# --- Database (MariaDB / MySQL) ---------------------------------------
DB_DRIVER=pdo_mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=jurytool
DB_USER=jurytool
DB_PASSWORD=jurytool

# --- Session tokens ----------------------------------------------------
# Generate with: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
JWT_SECRET=change-me-in-production
JWT_TTL=43200
AUTH_COOKIE=jurytool_session
AUTH_COOKIE_SECURE=false

# Local username/password login. Keep enabled so admins can get in before
# an OAuth consumer is registered; disable once OAuth is working.
LOCAL_LOGIN_ENABLED=true

# --- Wikimedia OAuth 2.0 ----------------------------------------------
# Register at:
# https://meta.wikimedia.org/wiki/Special:OAuthConsumerRegistration/propose/oauth2
# The callback URL registered there must match OAUTH_REDIRECT_URI exactly.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8080/api/auth/callback

# --- Wikimedia Commons -------------------------------------------------
COMMONS_API_URL=https://commons.wikimedia.org/w/api.php
# Wikimedia's API policy requires a descriptive, contactable User-Agent.
COMMONS_USER_AGENT="Snap/1.0 (https://snap.toolforge.org/; you@example.org)"
COMMONS_THUMB_WIDTH=1024
COMMONS_BATCH_SIZE=200

# --- Logging -----------------------------------------------------------
LOG_LEVEL=debug

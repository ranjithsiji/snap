# Copy to .env and adjust. Every value has a working default, so the app
# will boot without this file — but you must set JWT_SECRET in production.
#
# ON TOOLFORGE this whole file is nearly unnecessary. Snap reads
# ~/replica.my.cnf, and those credentials open both the tool's own
# database and the Commons replicas, so neither needs configuring. Only
# these actually have to be set there:
#
#   APP_ENV=prod
#   APP_URL=https://snap.toolforge.org
#   JWT_SECRET=<generated, see below>
#   OAUTH_CLIENT_ID / OAUTH_CLIENT_SECRET / OAUTH_REDIRECT_URI

APP_NAME="Snap"
APP_ENV=dev
APP_DEBUG=true
APP_URL=http://localhost:8080

# --- Database 1 of 2: the tool's own storage ---------------------------
# Campaigns, rounds, votes, users. Snap reads and writes this one; it is
# the only database holding anything the tool creates.
#
# Leave these unset on Toolforge. The user and password are taken from
# ~/replica.my.cnf, the host defaults to the tools cluster, and the name
# defaults to "<credential user>__snap" — Toolforge's own convention. It
# still has to be created once:
#   sql tools --execute "CREATE DATABASE ${USER}__snap;"
#
# The values below are for local development only.
DB_DRIVER=pdo_mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=jurytool
DB_USER=jurytool
DB_PASSWORD=jurytool

# --- Session tokens ----------------------------------------------------
# Generate with: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
JWT_SECRET=change-me-in-production
JWT_TTL=43200
AUTH_COOKIE=jurytool_session
AUTH_COOKIE_SECURE=false

# Local username/password login. Keep enabled so admins can get in before
# an OAuth consumer is registered; disable once OAuth is working.
LOCAL_LOGIN_ENABLED=true

# --- Wikimedia OAuth 2.0 ----------------------------------------------
# Register at:
# https://meta.wikimedia.org/wiki/Special:OAuthConsumerRegistration/propose/oauth2
# with "Applicable project" set to commons.wikimedia.org.
#
# The callback URL registered there must match OAUTH_REDIRECT_URI exactly —
# same scheme, host and path, since it is sent again when the code is
# exchanged and Wikimedia compares the two.
#
# Two paths are accepted, so register whichever you prefer:
#   https://snap.toolforge.org/wikicallback         (short, the default)
#   https://snap.toolforge.org/api/auth/callback    (grouped with the API)
# Set the one you registered here; changing it later means editing the
# consumer registration too.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8080/wikicallback

# The flow runs on the wiki the consumer names as its applicable project,
# not on Meta where it was registered. These default to Commons; set them
# only if the consumer is scoped to a different project (a Meta-scoped one
# wants meta.wikimedia.org in all three).
# OAUTH_AUTHORIZE_URL=https://commons.wikimedia.org/w/rest.php/oauth2/authorize
# OAUTH_TOKEN_URL=https://commons.wikimedia.org/w/rest.php/oauth2/access_token
# OAUTH_PROFILE_URL=https://commons.wikimedia.org/w/rest.php/oauth2/resource/profile

# --- Database 2 of 2: the Wikimedia Commons replica --------------------
# A read-only copy of Commons itself, on the *analytics* cluster. Snap
# never writes here; it reads a category in one SQL query instead of
# paging through the web API, which turns minutes into seconds.
#
# On Toolforge nothing below needs setting. The credentials in
# ~/replica.my.cnf open both this and the tool's own database, and Snap
# finds that file on its own — locating it is how the tool knows it is
# running on Toolforge. Off Toolforge the file is absent, the fast path
# stays off, and imports fall back to the Commons API automatically.
#
# Set these only to point at a replica by hand, e.g. over an SSH tunnel:
#   ssh -N -L 4711:commonswiki.analytics.db.svc.wikimedia.cloud:3306 \
#       yourname@login.toolforge.org
# then REPLICA_HOST=127.0.0.1 and REPLICA_PORT=4711.
#REPLICA_USER=
#REPLICA_PASSWORD=
#REPLICA_HOST=commonswiki.analytics.db.svc.wikimedia.cloud
#REPLICA_PORT=3306
#REPLICA_DB=commonswiki_p
# Path to the credentials file, if it is not in the usual place.
#REPLICA_CNF=
# Rows per keyset page. The replica is fast, so this far exceeds the
# API's ceiling of 500, while staying short enough that one statement
# cannot hit the replica's query timeout.
#REPLICA_BATCH_SIZE=10000
# A category with more files than this is refused rather than imported
# partway, since every row is held in memory until the import finishes.
# Far above any real campaign category.
#REPLICA_MAX_FILES=120000
# Set to 0 to force the API path even where a replica is reachable —
# useful for checking the two agree.
#REPLICA_ENABLED=1
# Both default to whatever `disable-ssl` says in replica.my.cnf, which on
# Toolforge is true. Set only to override that.
#REPLICA_DISABLE_SSL=
#DB_DISABLE_SSL=

# --- Wikimedia Commons (API fallback) ----------------------------------
# Used when the replica is unavailable, and for anything the replica
# cannot answer.
COMMONS_API_URL=https://commons.wikimedia.org/w/api.php
# Wikimedia's API policy requires a descriptive, contactable User-Agent.
COMMONS_USER_AGENT="Snap/1.0 (https://snap.toolforge.org/; you@example.org)"
COMMONS_THUMB_WIDTH=1024
COMMONS_BATCH_SIZE=200

# --- Logging -----------------------------------------------------------
LOG_LEVEL=debug

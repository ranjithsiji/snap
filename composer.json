{
    "name": "wikiloves/jurytool",
    "description": "Jury tool for Wiki Loves campaigns on Wikimedia Commons",
    "type": "project",
    "license": "GPL-3.0-or-later",
    "require": {
        "php": ">=8.2",
        "ext-curl": "*",
        "ext-json": "*",
        "doctrine/dbal": "^4.0",
        "doctrine/migrations": "^3.7",
        "doctrine/orm": "^3.1",
        "monolog/monolog": "^3.5",
        "php-di/php-di": "^7.0",
        "slim/psr7": "^1.6",
        "slim/slim": "^4.12",
        "symfony/cache": "^7.0",
        "symfony/var-exporter": "^8.1",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "symfony/var-dumper": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "JuryTool\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JuryTool\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "migrate": "doctrine-migrations migrations:migrate --no-interaction",
        "diff": "doctrine-migrations migrations:diff",
        "serve": "php -S localhost:8080 -t public",
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}

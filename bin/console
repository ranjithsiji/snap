#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Maintenance commands: schema management, user administration, and
 * re-importing campaign sources.
 *
 * Usage: bin/console <command> [arguments]
 */

use Doctrine\ORM\EntityManagerInterface;
use Doctrine\ORM\Tools\SchemaTool;
use JuryTool\Domain\Entity\Campaign;
use JuryTool\Domain\Entity\Round;
use JuryTool\Domain\Entity\User;
use JuryTool\Domain\Entity\RoleAssignment;
use JuryTool\Domain\Enum\UserRole;
use JuryTool\Service\ImportService;
use JuryTool\Service\RoundPopulationService;

$app = require dirname(__DIR__) . '/config/bootstrap.php';
$container = $app->getContainer();

/** @var EntityManagerInterface $em */
$em = $container->get(EntityManagerInterface::class);

$command = $argv[1] ?? 'help';
$args = array_slice($argv, 2);

/** All mapped entity metadata, for the schema commands. */
$metadata = static fn (): array => $em->getMetadataFactory()->getAllMetadata();

try {
    switch ($command) {
        case 'schema:create':
            (new SchemaTool($em))->createSchema($metadata());
            echo "Schema created.\n";

            break;

        case 'schema:update':
            (new SchemaTool($em))->updateSchema($metadata());
            echo "Schema updated.\n";

            break;

        case 'schema:drop':
            if (($args[0] ?? '') !== '--force') {
                echo "Refusing to drop the schema without --force.\n";
                exit(1);
            }

            (new SchemaTool($em))->dropSchema($metadata());
            echo "Schema dropped.\n";

            break;

        case 'schema:sql':
            // Prints the DDL without touching the database, so it can be
            // reviewed or applied by hand.
            foreach ((new SchemaTool($em))->getCreateSchemaSql($metadata()) as $sql) {
                echo $sql . ";\n";
            }

            break;

        case 'user:create':
            $username = $args[0] ?? null;
            $password = $args[1] ?? null;
            $role = UserRole::tryFrom($args[2] ?? 'admin') ?? UserRole::Admin;

            if ($username === null || $password === null) {
                echo "Usage: bin/console user:create <username> <password> [admin|lead|organizer|jury]\n";
                exit(1);
            }

            $canonical = User::canonicaliseUsername($username);

            if ($em->getRepository(User::class)->findOneBy(['username' => $canonical]) !== null) {
                echo "User '$canonical' already exists.\n";
                exit(1);
            }

            $user = new User($canonical, $role);
            $user->setPassword($password);

            $em->persist($user);

            // An admin's authority comes from a RoleAssignment, not the
            // baseline column, so the grant is created alongside the
            // account — otherwise the first admin could not do anything.
            if ($role === UserRole::Admin) {
                $em->persist(RoleAssignment::admin($user));
            }

            $em->flush();

            echo "Created {$role->value} '{$canonical}'.\n";

            break;

        case 'user:role':
            $username = $args[0] ?? null;
            $role = UserRole::tryFrom($args[1] ?? '');

            if ($username === null || $role === null) {
                echo "Usage: bin/console user:role <username> <admin|lead|organizer|jury>\n";
                exit(1);
            }

            $user = $em->getRepository(User::class)->findOneBy([
                'username' => User::canonicaliseUsername($username),
            ]);

            if ($user === null) {
                echo "No such user.\n";
                exit(1);
            }

            $user->setRole($role);

            $existingAdmin = $em->getRepository(RoleAssignment::class)
                ->findOneBy(['user' => $user, 'role' => UserRole::Admin]);

            if ($role === UserRole::Admin && $existingAdmin === null) {
                $em->persist(RoleAssignment::admin($user));
            } elseif ($role !== UserRole::Admin && $existingAdmin !== null) {
                // Standing down from admin removes the grant but never the
                // account: other seats and the login remain.
                $em->remove($existingAdmin);
            }

            $em->flush();

            echo "{$user->getUsername()} is now {$role->value}.\n";

            break;

        case 'user:list':
            foreach ($em->getRepository(User::class)->findAll() as $user) {
                printf(
                    "%-30s %-12s %s\n",
                    $user->getUsername(),
                    $user->getRole()->value,
                    $user->hasLocalPassword() ? 'local' : 'oauth',
                );
            }

            break;

        case 'campaign:import':
            $id = $args[0] ?? null;

            if ($id === null) {
                echo "Usage: bin/console campaign:import <campaignId>\n";
                exit(1);
            }

            $campaign = $em->getRepository(Campaign::class)->find((int) $id);

            if ($campaign === null) {
                echo "No such campaign.\n";
                exit(1);
            }

            $result = $container->get(ImportService::class)->importCampaign($campaign);

            printf(
                "Imported %d file(s): %d added, %d updated.\n",
                $result->processed,
                $result->added,
                $result->updated,
            );

            break;

        case 'round:import':
            $id = $args[0] ?? null;

            if ($id === null) {
                echo "Usage: bin/console round:import <roundId> [--populate]\n";
                echo "\n";
                echo "  Imports a round's own source directly on the server.\n";
                echo "  Intended for categories too large to import inside a\n";
                echo "  web request, which times out well before a category of\n";
                echo "  tens of thousands is read.\n";
                echo "\n";
                echo "  --populate  also add the imported files to the round\n";
                exit(1);
            }

            $round = $em->getRepository(Round::class)->find((int) $id);

            if ($round === null) {
                echo "No such round.\n";
                exit(1);
            }

            if (!$round->hasOwnSource()) {
                echo "Round '{$round->getName()}' has no source of its own.\n";
                exit(1);
            }

            $import = $container->get(ImportService::class);

            printf(
                "Importing %s into round %d (%s)\n",
                $round->getSourceCategory() ?? $round->getSourceUrl() ?? 'file list',
                $round->getId(),
                $round->getName(),
            );
            printf("Source: %s\n\n", $import->metadataSource());

            $started = microtime(true);

            // Progress is written as the import runs rather than at the
            // end: a large category takes minutes, and a silent terminal
            // is indistinguishable from a hung process.
            $outcome = $import->importRoundSource(
                $round,
                null,
                static function (int $processed, int $added, int $updated): void {
                    printf(
                        "\r  %s file(s) read — %s added, %s updated",
                        number_format($processed),
                        number_format($added),
                        number_format($updated),
                    );
                },
            );

            $result = $outcome['result'];

            printf(
                "\r  %s file(s) read — %s added, %s updated%s\n",
                number_format($result->processed),
                number_format($result->added),
                number_format($result->updated),
                str_repeat(' ', 12),
            );
            printf("Done in %.1fs\n", microtime(true) - $started);

            foreach ($outcome['warnings'] as $warning) {
                fwrite(STDERR, "  warning: {$warning}\n");
            }

            if (in_array('--populate', $args, true)) {
                // Read back from the pool rather than from the import, so
                // that memory stays flat however large the category was.
                $population = $container->get(RoundPopulationService::class)
                    ->populateFromCampaignPool($round);

                printf(
                    "Populated round: %d added, %d disqualified, %d skipped.\n",
                    $population->added,
                    $population->disqualified,
                    $population->skipped,
                );
            } else {
                echo "Run again with --populate to add these files to the round.\n";
            }

            break;

        case 'campaign:list':
            foreach ($em->getRepository(Campaign::class)->findAll() as $campaign) {
                printf(
                    "%-4d %-40s %-20s %d image(s)\n",
                    $campaign->getId(),
                    $campaign->getName(),
                    $campaign->getSourceType()->value,
                    $campaign->getImages()->count(),
                );
            }

            break;

        default:
            echo <<<TXT
            Snap — jury tool for Wiki Loves campaigns

            Schema
              schema:create              Create all tables
              schema:update              Apply entity changes to the database
              schema:drop --force        Drop all tables
              schema:sql                 Print the CREATE statements

            Users
              user:create <name> <pass> [role]   Create a local account
              user:role <name> <role>            Change a user's role
              user:list                          List all users

            Campaigns
              campaign:list                      List campaigns
              campaign:import <id>               Re-import a campaign source

            Rounds
              round:import <id> [--populate]     Import a round's source

                Runs the import on the server rather than inside a web
                request, which times out long before a category of tens of
                thousands is read. Progress is reported as it goes, and the
                import resumes rather than duplicating if re-run.

            TXT;

            break;
    }
} catch (Throwable $e) {
    fwrite(STDERR, 'Error: ' . $e->getMessage() . "\n");
    exit(1);
}
